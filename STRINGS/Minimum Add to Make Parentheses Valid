class Solution {
    public int minAddToMakeValid(String s) {
        Stack<Character> s1 = new Stack<>();
        Stack<Character> s2 = new Stack<>();
        int c = 0;
        int n = s.length();
        for(int i=0;i<n;i++){
           if(s.charAt(i)=='('){
                s1.push('(');
           }
           if(s.charAt(i) == ')' && s1.isEmpty()){
                c++;
           }else if(s.charAt(i) == ')' && !s1.isEmpty()){
                s1.pop();
           }
        }
       return c+s1.size();
    }
}
