class Solution {
    public void nextPermutation(int[] nums) {
        int n = nums.length;
        boolean is = true;
        for (int i = 0; i < n; i++) {
            if (i < n - 1 && nums[i] < nums[i + 1]) {
                is = false;
                break;
            }
        }
        if (!is) {
            int ind = -1;
            for (int i = n - 2; i >= 0; i--) {
                if (nums[i] < nums[i + 1]) {
                    ind = i;
                    break;
                }
            }

            for (int j = n - 1; j > ind; j--) {
                if (nums[j] > nums[ind]) {
                    int temp = nums[ind];
                    nums[ind] = nums[j];
                    nums[j] = temp;
                    break;
                }
            }
            int l = ind+1;
            int r = n-1;
            while(l<r){
                int temp = nums[l];
                nums[l] = nums[r];
                nums[r] = temp;
                l++;
                r--;
            }
        } else {
            for (int i = 0; i < n/2; i++) {
                int temp = nums[i];
                nums[i] = nums[n - i - 1];
                nums[n - i - 1] = temp;
            }
        }
    }
}
